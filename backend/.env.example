# Postgres: DATABASE_URL = rol dueño del esquema (migraciones / scripts). APP_DATABASE_URL = rol datta_app (la API).
DATABASE_URL=postgres://postgres:CAMBIAR@localhost:5432/datta
APP_DB_PASSWORD=CAMBIAR
APP_DATABASE_URL=postgres://datta_app:CAMBIAR@localhost:5432/datta
PORT=8081
COOKIE_SECURE=true
PUBLIC_ORIGIN=https://datta.example.com
STORAGE_DIR=./uploads
# 32 bytes en hex (openssl rand -hex 32): cifra la clave privada AFIP en reposo
SECRETS_KEY=
# Secreto para disparar los jobs internos manualmente
INTERNAL_CRON_SECRET=
# IA: poné UNA de las dos claves (AI_PROVIDER=auto usa la que esté cargada)
ANTHROPIC_API_KEY=
# Gratis: https://aistudio.google.com/apikey  (modelo por defecto gemini-2.5-flash)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
AI_PROVIDER=auto
RESEND_API_KEY=
REPORT_FROM_EMAIL=Datta <noreply@tu-dominio.com>
CRON_ENABLED=true
